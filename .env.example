POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=ollive
DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/ollive
DATABASE_SSL=false
DATABASE_SSL_MODE=disable
DATABASE_PREPARED_STATEMENT_CACHE_SIZE=100

API_HOST=0.0.0.0
