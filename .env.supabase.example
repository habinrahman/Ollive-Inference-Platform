# Supabase project:
# https://oxcmcqtaofsbanxigwtt.supabase.co
#
# Get the database password and connection host from:
# Supabase Dashboard -> Connect -> Connection string -> ORM
#
# Use the pooled connection string for local machines without IPv6 support.
# Convert the URL scheme from postgresql:// to postgresql+asyncpg://.

DATABASE_URL=postgresql+asyncpg://postgres.oxcmcqtaofsbanxigwtt:<YOUR_DB_PASSWORD>@<SUPABASE_POOLER_HOST>:6543/postgres
DATABASE_SSL=true
DATABASE_SSL_MODE=require
DATABASE_PREPARED_STATEMENT_CACHE_SIZE=0

API_CORS_ORIGINS=http://localhost:3000,http://localhost:3001
INGESTION_ENDPOINT=http://localhost:8000/v1/ingest/events

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ALLOW_MOCK_PROVIDER=false

NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_CHAT_URL=http://localhost:3000
NEXT_PUBLIC_DASHBOARD_URL=http://localhost:3001
