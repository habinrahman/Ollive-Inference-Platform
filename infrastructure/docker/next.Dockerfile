FROM node:20-alpine

ARG APP_NAME=frontend
ARG NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
ARG NEXT_PUBLIC_CHAT_URL=http://localhost:3000
ARG NEXT_PUBLIC_DASHBOARD_URL=http://localhost:3001
ENV NEXT_TELEMETRY_DISABLED=1
ENV NEXT_PUBLIC_API_BASE_URL=${NEXT_PUBLIC_API_BASE_URL}
ENV NEXT_PUBLIC_CHAT_URL=${NEXT_PUBLIC_CHAT_URL}
ENV NEXT_PUBLIC_DASHBOARD_URL=${NEXT_PUBLIC_DASHBOARD_URL}

WORKDIR /app

COPY apps/${APP_NAME}/package*.json ./
RUN npm install

COPY apps/${APP_NAME} ./
RUN npm run build

EXPOSE 3000

CMD ["npm", "start"]
